# ------------------------------------------------------------------
# Gokul Gruh Udhyog — Admin Order Management
# Copy this file to ".env" and fill in the values, then keep .env private.
# ------------------------------------------------------------------

# Database (SQLite file by default — no external service required).
# For Postgres later, change provider in prisma/schema.prisma and use a
# connection string here instead, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Session signing secret. MUST be set to a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial administrator account created by `npm run db:seed`.
# Change these before first seeding; you can change the password later in-app.
SEED_ADMIN_EMAIL="admin@gokulgruh.local"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
SEED_ADMIN_NAME="Kripal Dobariya"

# Optional: Google Maps Embed API key for the Contact page map.
# Without it, the Contact page falls back to a standard Google Maps search link.
# Create a key at https://console.cloud.google.com/ (enable "Maps Embed API").
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
